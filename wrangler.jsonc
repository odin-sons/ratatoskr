{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ratatoskr",
  "main": "src/cloudflare/worker.ts",
  "compatibility_date": "2026-09-18",
  "workers_dev": false,
  "preview_urls": false,
  "triggers": {
    "crons": ["*/5 * * * *", "0 3 * * *", "0 4 * * *", "0 5 * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ratatoskr",
      // PLACEHOLDER: run `wrangler d1 create ratatoskr` and paste the returned id here.
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID"
    }
  ],
  "observability": {
    "enabled": true
  }
}
