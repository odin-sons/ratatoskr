{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ratatoskr",
  "main": "src/cloudflare/worker.ts",
  "compatibility_date": "2026-09-18",
  "workers_dev": false,
  "preview_urls": false,
  "triggers": {
    "crons": ["*/5 * * * *", "1 3,4,5 * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ratatoskr",
      // PLACEHOLDER: run `wrangler d1 create <name>` (default name: ratatoskr) and put the returned id into .env as D1_DATABASE_ID.
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID"
    }
  ],
  // Defaults for a plain `wrangler deploy`. `pnpm run deploy` overrides these with --var from .env; see README.
  "vars": { "STORE_EMOJIS": {}, "LANGUAGE": "en" },
  "observability": {
    "enabled": true
  }
}
