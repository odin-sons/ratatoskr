# Copy to .env (git-ignored) and fill in.

# Loaded by `pnpm add-subscription`.
# The webhook URL is a credential: anyone holding it can post to the channel.
DISCORD_WEBHOOK_URL=

# Optional custom emoji shown next to the store name. Loaded by `pnpm run deploy`,
# which passes them to the Worker as the STORE_EMOJIS variable.
# Use the full markup with the emoji id, for example <:thunderstore:123456789012345678>
# (a plain :thunderstore: does not work through the Discord API). In Discord, type
# \:emoji_name: in a message and send it to see the markup. The emoji must belong to a
# server the webhook may use.
STORE_EMOJI_THUNDERSTORE=
STORE_EMOJI_HEXIUM=
STORE_EMOJI_NEXUS=
