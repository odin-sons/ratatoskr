# Copy to .env (git-ignored) and fill in.

# --- Discord webhooks, read by `pnpm add-subscription` -------------------------
# A webhook URL is a credential: anyone holding it can post to the channel.
# One variable per channel; the name is yours, pass it with --webhook-url-env.
DISCORD_WEBHOOK_URL=
# Example for a second and third channel (one subscription each, filtered by source):
#   pnpm add-subscription --guild-id <id> --webhook-url-env DISCORD_WEBHOOK_URL_HEXIUM --source hexium:valheim
DISCORD_WEBHOOK_URL_HEXIUM=
DISCORD_WEBHOOK_URL_NEXUS=

# --- Deploy, read by `pnpm run deploy` ------------------------------------------
# Your D1 database's id (from `wrangler d1 create` or `wrangler d1 list`). Substituted
# for wrangler.jsonc's committed placeholder at deploy time; never committed itself.
D1_DATABASE_ID=

# Optional names, both default to "ratatoskr". Set them to run several instances on one
# Cloudflare account: every instance needs its own Worker name and its own D1 database.
# Worker: lowercase letters, digits and hyphens. Database: the name you gave `wrangler d1 create`.
# `pnpm add-subscription` and `pnpm subscriptions` use D1_DATABASE_NAME as their --database default.
WORKER_NAME=
D1_DATABASE_NAME=

# Passed to the Worker as variables at deploy time.
# Message language (a catalog in src/i18n): en, ru. Default: en. Passed to the Worker as LANGUAGE;
# the name here is RATATOSKR_LANGUAGE because the POSIX LANGUAGE variable is a locale setting.
RATATOSKR_LANGUAGE=

# Optional custom emoji. Use the full markup with the emoji id, for example
# <:name:123456789012345678> (a plain :name: does not work through the Discord API).
# In Discord, type \:emoji_name: in a message and send it to see the markup.
# The emoji must belong to a server the webhook may use.
# Store icons: shown in the message title and on the "Mod page" button.
STORE_EMOJI_THUNDERSTORE=
STORE_EMOJI_HEXIUM=
STORE_EMOJI_NEXUS=
# Shown on the button that links to this project's source.
RATATOSKR_EMOJI=
